# Puerto de la API
PORT=4000

# Base de datos. Local: SQLite. Producción: cambiar provider a "postgresql" en prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Seguridad (cambiar en producción)
JWT_SECRET="cambia-esta-clave-en-produccion"
ADMIN_EMAIL="admin@auracapilar.local"
ADMIN_PASSWORD="aura2026"

# Orígenes permitidos (frontend), separados por coma
CORS_ORIGINS="http://localhost:3000"

# Storage de imágenes/videos: local (s3/cloudinary se agregan como nuevos drivers)
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=200
